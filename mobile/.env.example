# Copy to .env and set to your dev machine's LAN IP (must be reachable from
# your phone — so both need to be on the same Wi-Fi network). Find yours with
# `ipconfig` on Windows and look for the interface your phone shares a
# network with. "localhost" will NOT work from a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.28:8000/api/v1
