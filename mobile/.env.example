# You normally don't need to touch this. During development the app finds
# the backend by itself: it uses the same address the phone loaded the app
# from (the PC running Expo), on port 8000.
#
# This value is only used as a fallback — for production builds, or when
# Expo runs in tunnel mode (`expo start --tunnel`).
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Set to 1 to ignore auto-detection and always use EXPO_PUBLIC_API_URL
# (e.g. to point the app at a backend on a different machine).
# EXPO_PUBLIC_API_URL_FORCE=1
